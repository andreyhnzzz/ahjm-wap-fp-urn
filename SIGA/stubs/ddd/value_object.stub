<?php

declare(strict_types=1);

namespace Src\{{Context}}\{{Entity}}\Domain\ValueObjects;

use InvalidArgumentException;

/**
 * Immutable Value Object. Equality is by value, not identity — two
 * instances holding the same $value are interchangeable.
 */
final class {{Entity}}NameVO
{
    private string $value;

    public function __construct(string $value)
    {
        $trimmed = trim($value);

        if ($trimmed === '') {
            throw new InvalidArgumentException('{{Entity}} name cannot be empty.');
        }

        if (mb_strlen($trimmed) > 255) {
            throw new InvalidArgumentException('{{Entity}} name cannot exceed 255 characters.');
        }

        $this->value = $trimmed;
    }

    public function value(): string
    {
        return $this->value;
    }

    public function equals(self $other): bool
    {
        return $this->value === $other->value;
    }

    public function __toString(): string
    {
        return $this->value;
    }
}
