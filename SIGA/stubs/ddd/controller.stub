/**
 * Primary adapter: translates HTTP in, delegates to the Application
 * layer, translates the result back out. No business logic lives here.
 */
class {{Entity}}Controller extends Controller
{
    public function store({{Entity}}Request $request, Create{{Entity}}UseCase $useCase): JsonResponse
    {
        $dto = {{Entity}}DTO::fromArray($request->validated());

