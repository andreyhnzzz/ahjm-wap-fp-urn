APP_NAME="SIGA UTN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Academic offer analytics (Reports RE-01/RE-02, Risk board RE-04) ------
# Business thresholds, documented in config/academic.php.
ACADEMIC_DEFAULT_TERM=2026-II
ACADEMIC_RISK_MIN_ENROLLMENT=5
ACADEMIC_RISK_MAX_WORKLOAD=1.0
ACADEMIC_RISK_REFRESH_SECONDS=15
ACADEMIC_UNDER_LOAD_RATIO=0.8
ACADEMIC_REPORT_DISK=local
ACADEMIC_REPORT_MAX_SECONDS=30

# --- JSON API auth (routes/api.php) ----------------------------------------
# Independent from APP_KEY on purpose (see config/jwt.php). Generate with:
# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=3600

# --- PDF export rendering (config/exports.php) ------------------------------
# Technical, not business: nothing here changes what a report says.
#
# PDF_TAGGED: Chrome emits a PDF/UA structure tree by default — one object
# per <td>. On a 2500-row export that is 8.9 MB vs 0.8 MB and 2.66s vs 1.96s.
# Off by default; the .xlsx generated from the same rows is the accessible
# artifact for tabular data.
PDF_TAGGED=false
#
# The warm-Chrome sidecar (scripts/pdf-sidecar.mjs). `composer run dev`
# starts it; in production run `npm run pdf:sidecar` under a supervisor.
# With autostart on, the app launches it on demand if nothing is listening
# and still falls back to Browsershot if it does not come up.
PDF_SIDECAR_PORT=8720
PDF_SIDECAR_AUTOSTART=true
PDF_SIDECAR_BOOT_TIMEOUT=10
PDF_SIDECAR_RENDER_TIMEOUT=120

# —- Host sizing (config/host.php) —————————————————————
# How many chunk renders of a large PDF export run at once. Derived from
# the cores this machine actually has (cores - 2, floor 2, ceiling 16) and
# used by BOTH halves of the export path: the PHP writer that sends the
# requests and the Node sidecar that serves them. Leave these unset unless
# you know better than the probe — a container capped at 2 CPUs by its
# orchestrator while the kernel still reports 64 is the case they exist for.
# Run `php artisan host:profile` to see what this host resolved to.
# HOST_CORES=
# PDF_SIDECAR_CONCURRENCY=
# HOST_BUDGET_SCALE=

# Seconds the worker gives a queued export before killing it. Derived from
# the host (300 s on the reference machine, scaled up on a smaller one);
# config/queue.php keeps DB_QUEUE_RETRY_AFTER above it so the queue never
# hands a still-running export to a second worker.
# EXPORT_JOB_TIMEOUT=
